# Copy this file to .env and fill in your values.
# Never commit .env to version control.

EMAIL_SENDER=you@gmail.com
EMAIL_PASSWORD=your-app-password-here

# Comma-separated recipients per region
EMAIL_RECIPIENT_NEWEGG=recipient@example.com
EMAIL_RECIPIENT_KAKAKU=recipient@example.com
EMAIL_RECIPIENT_DANAWA=recipient@example.com

# Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Overrides the default "[Newegg|Kakaku|Danawa] Motherboard Dashboard" subject for all regions
# EMAIL_SUBJECT=Motherboard Dashboard
